{
  "LIGHTWEIGHT": {
    "EXECUTION" : {
      "emitOn": ["EXECUTION_START", "EXECUTION_END"],
      "properties": ["id", "connectionId"],
      "segments": {
        "EXCEPTION": ["data"]
      }
    },
    "FLOWCHART" : {
      "emitOn": ["FLOWCHART_START", "FLOWCHART_END"],
      "properties": ["flowId", "connectorId", "name", "connectorName"],
      "segments": {
        "EXCEPTION": ["data"]
      }
    },
    "OPERATION" : {
      "emitOn": ["OPERATION_END"],
      "properties": ["name", "indexPath", "loopIndex", "loopIterator"],
      "segments": {
        "REQUEST": ["url", "http_method"],
        "RESPONSE": ["status", "duration"],
        "EXCEPTION": ["data"]
      }
    },
    "IF" : {
      "emitOn": ["IF_RESULT", "IF_END"],
      "properties" : ["indexPath", "expression", "loopIndex", "loopIterator"],
      "segments" : {
        "IF_RESULT": ["data"],
        "EXCEPTION": ["data"]
      }
    },
    "LOOP" : {
      "emitOn": ["LOOP_START", "LOOP_END"],
      "properties" : ["indexPath", "expression", "iterator", "loopIndex", "loopIterator"],
      "segments" : {
        "EXCEPTION": ["data"]
      }
    }
  },
  "DETAILED": {
    "OPERATION" : {
      "emitOn": ["OPERATION_END"],
      "properties": ["name", "indexPath", "loopIndex", "loopIterator"],
      "segments": {
        "REQUEST": ["url", "http_method"],
        "REQUEST_HEADER": ["data"],
        "REQUEST_PAYLOAD": ["data"],
        "RESPONSE": ["status", "duration"],
        "RESPONSE_HEADER": ["data"],
        "RESPONSE_PAYLOAD": ["data"],
        "EXCEPTION": ["data"]
      }
    },
    "IF" : {
      "emitOn": ["IF_RESULT", "IF_END"],
      "properties" : ["indexPath", "expression", "loopIndex", "loopIterator"],
      "segments" : {
        "IF_RESULT": ["data"],
        "IF_REF": ["ref", "data"],
        "EXCEPTION": ["data"]
      }
    },
    "LOOP" : {
      "emitOn": ["LOOP_REF"],
      "properties" : ["indexPath", "expression", "iterator", "loopIndex", "loopIterator"],
      "segments" : {
        "LOOP_REF": ["data"],
        "EXCEPTION": ["data"]
      }
    }
  }
}