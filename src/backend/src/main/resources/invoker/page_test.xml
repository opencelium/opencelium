<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<invoker type="RESTful">
    <name>page_test</name>
    <description>Pagination TEST</description>
    <hint>Pagination test</hint>
    <requiredData>
        <item name="url" type="string" visibility="public"/>
        <item name="username" type="string" visibility="public"/>
        <item name="password" type="string" visibility="protected"/>
        <item name="basic" type="string" visibility="private">{username:password}</item>
    </requiredData>
    <authType>token</authType>
    <pagination>
        <limit>5</limit>
        <result ref="response.body.$.items" action="collect"/>
        <link ref="response.body.$.nextLink"/>
    </pagination>
    <operations>
        <operation name="GetAllUser" type="test">
            <request>
                <method>GET</method>
                <endpoint>{url}/page/user/all</endpoint>
                <header>
                    <item name="Authorization" type="string">{token}</item>
                </header>
                <body/>
            </request>
            <response>
                <success status="200">
                    <header>
                        <item name="Content-Type" type="string">application/json</item>
                    </header>
                    <body data="raw" format="json" type="array">
                        <field name="id" type="number"/>
                        <field name="name" type="string"/>
                        <field name="role" type="string"/>
                        <field name="department" type="string"/>
                        <field name="units" type="array"/>
                    </body>
                </success>
                <fail status="401">
                    <body/>
                </fail>
            </response>
        </operation>
        <operation name="paginate" type="page">
            <pagination>
                <limit>5</limit>
                <size>30</size>
                <result ref="response.body.$.content" action="collect"/>
                <page action="increment">0</page>
<!--                <size ref="response.body.$.totalElements" action="read"/>-->
<!--                <has_more ref="response.body.$.content" action="read"/>-->
            </pagination>
            <request>
                <method>GET</method>
                <endpoint>{url}/page/example?size=@{limit}&amp;page=@{page}</endpoint>
                <body/>
                <header>
                    <item name="Authorization" type="string">{basic}</item>
                    <item name="Content-Type" type="string">application/json</item>
                </header>
            </request>
            <response>
                <success status="200">
                    <header>
                        <item name="Content-Type" type="string">application/json</item>
                    </header>
                    <body type="object" format="json" data="raw">
                        <field name="content" type="array">
                            <field name="id" type="string"/>
                            <field name="name" type="string"/>
                            <field name="username" type="string"/>
                        </field>
                        <field name="totalElements" type="number"/>
                    </body>
                </success>
                <fail status="401">
                    <header/>
                    <body/>
                </fail>
            </response>
        </operation>
        <operation name="paginate2" type="page">
            <request>
                <method>GET</method>
                <endpoint>{url}/cursor/example?size=@{limit}</endpoint>
                <body/>
                <header>
                    <item name="Authorization" type="string">{basic}</item>
                    <item name="Content-Type" type="string">application/json</item>
                </header>
            </request>
            <response>
                <success status="200">
<!--                    <header>-->
<!--                        <item name="Content-Type" type="string">application/json</item>-->
<!--                    </header>-->
                    <body type="object" format="json" data="raw">
                        <field name="items" type="array">
                            <field name="id" type="string"/>
                            <field name="name" type="string"/>
                            <field name="username" type="string"/>
                        </field>
                        <field name="nextCursor" type="string"/>
                        <field name="nextLink" type="string"/>
                        <field name="forin" type="string"/>
                    </body>
                </success>
                <fail status="401">
                    <header/>
                    <body/>
                </fail>
            </response>
        </operation>
        <operation name="paginate3" type="page">
            <pagination>
                <limit>5</limit>
                <result ref="response.body.$.items" action="collect"/>
                <offset action="increment">0</offset>
                <size ref="response.body.$.total" action="read"/>
            </pagination>
            <request>
                <method>GET</method>
                <endpoint>{url}/offset/example?offset=@{offset}&amp;limit=@{limit}</endpoint>
                <body/>
                <header>
                    <item name="Authorization" type="string">{basic}</item>
                    <item name="Content-Type" type="string">application/json</item>
                </header>
            </request>
            <response>
                <success status="200">
                    <header>
                        <item name="Content-Type" type="string">application/json</item>
                    </header>
                    <body type="object" format="json" data="raw">
                        <field name="items" type="array">
                            <field name="id" type="string"/>
                            <field name="name" type="string"/>
                            <field name="username" type="string"/>
                        </field>
                        <field name="nextCursor" type="string"/>
                        <field name="nextLink" type="string"/>
                        <field name="forin" type="string"/>
                        <field name="total" type="string"/>
                        <field name="offset" type="string"/>
                        <field name="limit" type="string"/>
                    </body>
                </success>
                <fail status="401">
                    <header/>
                    <body/>
                </fail>
            </response>
        </operation>
    </operations>
</invoker>
