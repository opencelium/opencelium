{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.4",
        "body": [
          {
            "type": "TextBlock",
            "size": "Medium",
            "weight": "Bolder",
            "text": "${subject}",
            "wrap": true
          },
          {
            "type": "TextBlock",
            "text": "${text}",
            "wrap": true
          }
        ]
      }
    }
  ]
}
