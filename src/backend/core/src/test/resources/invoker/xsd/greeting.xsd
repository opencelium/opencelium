<?xml version="1.0" encoding="UTF-8"?>
<!-- A minimal schema for testing validation independently of the invoker format. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="greeting">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="count" type="xs:integer"/>
            </xs:sequence>
            <xs:attribute name="lang" use="required" type="xs:string"/>
        </xs:complexType>
    </xs:element>
</xs:schema>
