<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- A 5.x JSON-RPC invoker: every call answers 200, success or not. Fictional API. -->
<invoker type="RESTful">
    <name>Demo CMDB</name>
    <description>JSON-RPC configuration database.</description>
    <hint>Enter the JSON-RPC URL.</hint>
    <icon>cmdb.png</icon>
    <requiredData>
        <item name="url" type="string" visibility="public">http://{HOST}/jsonrpc.php</item>
        <item name="apikey" type="string" visibility="public"/>
        <item name="username" type="text" visibility="public"/>
        <item name="password" type="string" visibility="protected"/>
        <item name="sessionid" type="string" visibility="private">%{login.body.result.session-id}</item>
    </requiredData>
    <authType>token</authType>
    <category_tags>
        <item>CMDB</item>
        <item>Asset Management</item>
    </category_tags>
    <operations>
        <operation name="login" type="test">
            <request>
                <method>POST</method>
                <endpoint>{url}</endpoint>
                <header>
                    <item name="Content-Type" type="string">application/json</item>
                    <item name="X-RPC-Auth-Username" type="string">{username}</item>
                </header>
                <body data="raw" format="json" type="object">
                    <field name="version" type="string">2.0</field>
                    <field name="method" type="string">idoit.login</field>
                    <field name="params" type="object">
                        <field name="apikey" type="string">{apikey}</field>
                    </field>
                    <field name="id" required="true" type="string">1</field>
                </body>
            </request>
            <response>
                <success status="200">
                    <header>
                        <item name="Content-Type" type="string">application/json</item>
                    </header>
                    <body data="raw" format="json" type="object">
                        <field name="jsonrpc" type="string">2.0</field>
                        <field name="result" type="object">
                            <field name="session-id" type="string"/>
                        </field>
                    </body>
                </success>
                <fail status="200">
                    <header>
                        <item name="Content-Type" type="string">application/json</item>
                    </header>
                    <body data="raw" format="json" type="object">
                        <field name="jsonrpc" type="string"/>
                        <field name="error" type="object">
                            <field name="code" type="number"/>
                            <field name="message" type="string"/>
                        </field>
                    </body>
                </fail>
            </response>
        </operation>
        <operation name="cmdb.objects.read" type="">
            <request>
                <method>GET</method>
                <endpoint>{url}/objects?include=CurrentVersion&amp;limit=50</endpoint>
                <header>
                    <item name="X-RPC-Auth-Session" type="string">{sessionid}</item>
                </header>
            </request>
            <response>
                <success status="200">
                    <body data="application/json" format="json" type="object">
                        <field name="result" type="array">
                            <field name="id" type="string"/>
                            <field name="title" type="string"/>
                            <field name="range from" type="string"/>
                        </field>
                        <field name="ids" type="array"/>
                        <field name="tags" type="array">a,b</field>
                    </body>
                </success>
                <fail status="404">
                    <body data="raw" format="json" type="object">
                        <field name="message" type="string"/>
                    </body>
                </fail>
            </response>
        </operation>
    </operations>
</invoker>
