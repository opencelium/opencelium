        <mxCell id="eB1" edge="1" parent="1" source="gradle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=1.5;strokeColor=#666666;dashed=1;dashPattern=1 3;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="jarApp">
