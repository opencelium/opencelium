# API_URL / SOCKET_URL moved to public/config.json — a runtime config file fetched at
# startup and editable post-build (see public/config.json and @shared/config/runtimeConfig).
# VITE_API_URL / VITE_SOCKET_URL below are only used as a dev fallback if config.json
# is missing or fails to load.
VITE_API_URL=http://localhost:9090
VITE_SOCKET_URL=http://localhost:9090/ws
# Set to false to disable MSW mocks and send all requests to the real backend.
VITE_ENABLE_MOCKS=false

# --- AI assistants (field-binding suggester + enhancement script) ------------
# Unset: the MSW mock answers /ai/* with deterministic rules — no model, no cost.
#
# To use a real model in dev, create .env.local (ignored by *.local in .gitignore;
# this file is NOT ignored, so a key must never be written here) containing:
#
#   ANTHROPIC_API_KEY=sk-ant-...        # no VITE_ prefix: stays in the dev server
#   VITE_ENABLE_AI_MOCK=false           # stand the MSW mock down
#   VITE_AI_PROXY_URL=http://localhost:5173
