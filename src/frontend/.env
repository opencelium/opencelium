# API_URL / SOCKET_URL moved to public/config.js — a runtime config file served
# as-is and editable post-build (see public/config.js and @shared/config/runtimeConfig).
# VITE_API_URL / VITE_SOCKET_URL below are only used as a dev fallback if config.js
# has no value set for them.
VITE_API_URL=http://localhost:9090
VITE_SOCKET_URL=http://localhost:9090/ws
# Set to false to disable MSW mocks and send all requests to the real backend.
VITE_ENABLE_MOCKS=false
