          "description": "Iterates through the properties of an object.",
          "args": [{ "code": "o1", "text": "An object whose properties should be iterated." }],
          "examples": [
            { "code": "o1 = {\"name\":\"Hob\",\"age\":123}", "result": "Iterates through properties \"name\", \"age\"" },
